# ==============================================================================
# AirWise AI — Unified Monorepo Environment Template
# ==============================================================================
# Single source of truth for local development, Docker Compose, and Vercel.
# Local setup: copy to `.env` (`cp .env.example .env`) and optionally to
# `frontend/.env.local` for browser-public `NEXT_PUBLIC_*` overrides.
# For Vercel production, import this file and set the production overrides noted
# inline (`APP_ENV=production`, `AUTH_COOKIE_SECURE=true`, `NEXT_PUBLIC_API_BASE_URL=/api/v1`, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Public Variables (Exposed to browser — NEVER place secrets here)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=AirWise AI
# Local dev points to FastAPI on :8000; on Vercel set NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Supported: india_naqi | us_epa
NEXT_PUBLIC_DEFAULT_AQI_STANDARD=india_naqi

# ------------------------------------------------------------------------------
# 2. Core Application & Runtime Mode
# ------------------------------------------------------------------------------
APP_NAME=AirWise AI
# Supported: development | test | staging | production
APP_ENV=development
# MUST be false when APP_ENV=production
DEBUG=false

# Public origins used for CORS & CSRF Origin checks (set to https://<project>.vercel.app in prod)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Authentication, Cookie & Session Security
# ------------------------------------------------------------------------------
# Generate >= 32 random bytes in production: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=dev-only-replace-with-cryptographic-random-secret-key
# MUST be true when APP_ENV=production
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 4. PostgreSQL 16 (PostGIS + pgvector) & Redis 7+
# ------------------------------------------------------------------------------
# Production: use Supabase Session Pooler (:5432) or Neon `postgresql+asyncpg://` URI
DATABASE_URL=postgresql+asyncpg://airwise:airwise_dev_only@localhost:5432/airwise
# Set `true` on Vercel/serverless to enable SQLAlchemy NullPool
DATABASE_SERVERLESS_POOL=false

# Production: Upstash Serverless Redis TLS URL (`rediss://default:<pass>@<host>.upstash.io:6379`)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Google Gemini GenAI & RAG Embeddings Gateway (Backend-only)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_TOKEN_BUDGET=200000
AI_REQUESTS_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 6. Environmental Telemetry & Geocoding Providers
# ------------------------------------------------------------------------------
# Supported: openaq | openweather | open_meteo | cpcb | fixture (`fixture` is rejected in production)
AIR_QUALITY_PROVIDER=fixture
# Supported: open_meteo | openweather | openaq | none (`open_meteo` is free & keyless)
AIR_QUALITY_FALLBACK_PROVIDER=open_meteo
AIR_QUALITY_API_KEY=
AIR_QUALITY_FALLBACK_API_KEY=

# Supported: open_meteo | openweather | fixture (`fixture` is rejected in production)
WEATHER_PROVIDER=fixture
WEATHER_API_KEY=

# Supported: openweather | mapbox
GEOCODING_PROVIDER=openweather
GEOCODING_API_KEY=

# ------------------------------------------------------------------------------
# 7. Transactional Email & Alert Delivery
# ------------------------------------------------------------------------------
# Supported: console | resend
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@airwise.app

# ------------------------------------------------------------------------------
# 8. Optional Google OAuth 2.0 Sign-In Adapter
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# ------------------------------------------------------------------------------
# 9. Scheduled Cron & Observability Security
# ------------------------------------------------------------------------------
# Sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
# Required when APP_ENV=production; protects `/metrics` via `X-Metrics-Token`
METRICS_INTERNAL_TOKEN=
OTEL_SERVICE_NAME=airwise-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
