# ==============================================================================
# AirWise AI — Unified Monorepo Environment Template (Vercel Production)
# ==============================================================================
# Import this file (or paste its contents) into:
#   Vercel Dashboard -> Project Settings -> Environment Variables
# Keep Vercel "Root Directory" set to `./` (repository root) so `vercel.json`
# builds `frontend/` and mounts FastAPI serverless routes via `api/index.py`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Public Variables (Exposed to browser — NEVER place secrets here)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=AirWise AI
# Same-origin rewrite path handled by `vercel.json` -> `/api/index.py`
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Supported: india_naqi | us_epa
NEXT_PUBLIC_DEFAULT_AQI_STANDARD=india_naqi

# ------------------------------------------------------------------------------
# 2. Core Application & Runtime Mode
# ------------------------------------------------------------------------------
APP_NAME=AirWise AI
# Supported: development | test | staging | production
APP_ENV=production
# MUST be false when APP_ENV=production
DEBUG=false

# Exact public Vercel URL (no trailing slash) — used for CORS & CSRF Origin checks
FRONTEND_URL=https://your-project-name.vercel.app
BACKEND_URL=https://your-project-name.vercel.app

# ------------------------------------------------------------------------------
# 3. Authentication, Cookie & Session Security
# ------------------------------------------------------------------------------
# Generate >= 32 random bytes: python -c "import secrets; print(secrets.token_hex(32))"
# MUST NOT start with `dev-only` when APP_ENV=production
AUTH_SECRET_KEY=replace-with-64-char-cryptographic-random-hex-secret
# MUST be true when APP_ENV=production
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 4. PostgreSQL 16 (Supabase Session Pooler :5432 / Neon) & Upstash Redis
# ------------------------------------------------------------------------------
# For Supabase on Vercel (IPv4), use the Session Pooler (:5432) URI with `postgresql+asyncpg://`
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres
# Enables SQLAlchemy NullPool for serverless invocations
DATABASE_SERVERLESS_POOL=true

# Upstash Serverless Redis TLS URL (`rediss://...`)
REDIS_URL=rediss://default:your_upstash_password@your_upstash_endpoint.upstash.io:6379

# ------------------------------------------------------------------------------
# 5. Google Gemini GenAI & RAG Embeddings Gateway (Backend-only)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_TOKEN_BUDGET=200000
AI_REQUESTS_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 6. Environmental Telemetry & Geocoding Providers
# ------------------------------------------------------------------------------
# Supported in production: openaq | openweather | open_meteo | cpcb (`fixture` is rejected)
AIR_QUALITY_PROVIDER=openaq
# Supported: open_meteo | openweather | openaq | none (`open_meteo` is free & keyless)
AIR_QUALITY_FALLBACK_PROVIDER=open_meteo
AIR_QUALITY_API_KEY=
# Optional separate key only if AIR_QUALITY_FALLBACK_PROVIDER=openweather
AIR_QUALITY_FALLBACK_API_KEY=

# Supported in production: open_meteo | openweather (`open_meteo` works without an API key)
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=

# Supported: openweather | mapbox
GEOCODING_PROVIDER=openweather
GEOCODING_API_KEY=

# ------------------------------------------------------------------------------
# 7. Transactional Email & Alert Delivery
# ------------------------------------------------------------------------------
# Supported: console | resend
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@airwise.app

# ------------------------------------------------------------------------------
# 8. Optional Google OAuth 2.0 Sign-In Adapter
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-project-name.vercel.app/api/v1/auth/oauth/google/callback

# ------------------------------------------------------------------------------
# 9. Scheduled Cron & Observability Security
# ------------------------------------------------------------------------------
# Sent automatically by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=replace-with-32-char-random-hex-secret

# Protects `/metrics` via `X-Metrics-Token` header
METRICS_INTERNAL_TOKEN=replace-with-32-char-random-hex-secret
OTEL_SERVICE_NAME=airwise-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
