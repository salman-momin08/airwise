APP_NAME=AirWise AI
APP_ENV=development
DEBUG=false

# PostgreSQL 16+ (with PostGIS + pgvector) and Redis 7+
DATABASE_URL=postgresql+asyncpg://airwise:airwise_dev_only@localhost:5432/airwise
REDIS_URL=redis://localhost:6379/0

# Authentication & Session Security (Replace AUTH_SECRET_KEY with >= 32 random bytes in non-dev)
AUTH_SECRET_KEY=dev-only-replace-with-cryptographic-random-secret-key
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=86400

# GenAI Gateway (OpenAI initial provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Environmental Data Providers
# Supported: openaq | openweather | fixture (fixture is rejected when APP_ENV=production)
AIR_QUALITY_PROVIDER=fixture
AIR_QUALITY_FALLBACK_PROVIDER=openweather
AIR_QUALITY_API_KEY=

WEATHER_PROVIDER=fixture
WEATHER_API_KEY=

GEOCODING_PROVIDER=openweather
GEOCODING_API_KEY=

EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@airwise.app

# Optional Google OAuth 2.0 Adapter Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Hosting & Serverless Settings (Vercel + Neon/Supabase + Upstash Free Tier)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DATABASE_SERVERLESS_POOL=false
CRON_SECRET=

# Observability
OTEL_SERVICE_NAME=airwise-backend
METRICS_INTERNAL_TOKEN=
