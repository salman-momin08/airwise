NEXT_PUBLIC_APP_NAME=AirWise AI
# Local dev points to FastAPI on :8000; on Vercel set NEXT_PUBLIC_API_BASE_URL=/api/v1 (same-origin rewrite)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_AQI_STANDARD=india_naqi
# Never add backend API keys or secrets to NEXT_PUBLIC_* variables.
